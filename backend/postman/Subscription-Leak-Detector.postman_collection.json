    {
      "name": "2. Auth",
      "description": "User registration, password validation, authentication, JWT issuing, and profile endpoints.",
      "item": [
        {
          "name": "Register Valid User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"Demo@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user account. Uses pre-request script to generate a unique demoEmail so runs never collide. Returns HTTP 201 without exposing password hash."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique demo email if not already set",
                  "if (!pm.collectionVariables.get(\"demoEmail\")) {",
                  "    pm.collectionVariables.set(\"demoEmail\", \"demo\" + Date.now() + \"@example.com\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Check status code is 201 Created",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Check success message and user object without password",
                  "pm.test(\"User registered successfully without password\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.message).to.eql(\"User Registered Successfully\");",
                  "    pm.expect(data.user).to.be.an(\"object\");",
                  "    pm.expect(data.user.email).to.eql(pm.collectionVariables.get(\"demoEmail\"));",
                  "    pm.expect(data.user.password).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Duplicate User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"Demo@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Attempts to register the exact same email again. Fails fast with HTTP 409 Conflict to prevent duplicate accounts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Check status code is 409 Conflict",
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "// Check duplicate message",
                  "pm.test(\"Message is User Already Exists\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.message).to.eql(\"User Already Exists\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Weak Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weak User\",\n  \"email\": \"weak@example.com\",\n  \"password\": \"abc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Demonstrates validateRegister middleware rejecting a password under 8 characters without uppercase or special character before the controller runs. Returns HTTP 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Check status code is 400 Bad Request",
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "// Check validation error structure",
                  "pm.test(\"Response contains validation errors array\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.message).to.eql(\"Validation failed\");",
                  "    pm.expect(data.errors).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
